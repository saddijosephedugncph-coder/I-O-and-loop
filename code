import java.util.Scanner;

public class StudentGradingSystem {
  public static void main(String[] args) {
    Scanner scanner = new Scanner(System.in);
    String choice;
    do {
            
        System.out.print("Enter Student Name: ");
        String name = scanner.nextLine();

        System.out.print("Enter Student Age: ");
        int age = scanner.nextInt();
 
        double hci = getValidGrade(scanner, "HCI");
        double cc103 = getValidGrade(scanner, "CC103");
        double net = getValidGrade(scanner, "Net");

        double average = (hci + cc103 + net) / 3.0;
            
            String status = (average >= 75.0) ? "PASSED" : "FAILED";
            System.out.println("====================");

            System.out.println("676767 NIGGAS STUDENT REPORT 676767");
            System.out.println("Name: " + name);
            System.out.println("Age: " + age);
            System.out.println("HCI: " + hci);
            System.out.println("CC103: " + cc103);
            System.out.println("Net: " + net);
            System.out.printf("Average: %.2f%n", average);
            System.out.println("Status : " + status);
            System.out.println("===================");
            
            System.out.print("Do you want to enter another student? (Y/N): ");
            choice = scanner.next().trim();
            scanner.nextLine(); 

            System.out.println(); 

        } while (choice.equalsIgnoreCase("YES") || choice.equalsIgnoreCase("Y"));

        System.out.println("=====SAMMARY=====");
        System.out.println("Students: ewan. di ko alam gawin to eh");
        System.out.println("Passed: ewan. di ko alam gawin to eh");
        System.out.println("Failed: ewan. di ko alam gawin to eh");
        scanner.close();
    }

    private static int getValidGrade(Scanner sc, String subjectName) {
        int grade;
        while (true) {
            System.out.print("Enter " + subjectName + " Grade (2-99): ");
        if (sc.hasNextInt()) {
            grade = sc.nextInt();
               if (grade >= 2 && grade <= 99) {
                 break; 
              }
          } else {
               sc.next(); 
           }
        System.out.println("Error: Grade must be a whole number between 2 and 99.");
        }
      return grade;
    }
}

         
